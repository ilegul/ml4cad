# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.pyd
*.so

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Environment variables
.env

# Inputs (data/raw, data/processed) and outputs (results, figures,
# predictions) are tracked, so the analysis can be reproduced and audited
# from the repository alone.

# Fitted estimators are not tracked: 177 MB of binaries that the pipeline
# regenerates from the data and the cached search results.
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pickle

# Resumable intermediates, regenerated on demand.
cache/*
!cache/.gitkeep

# Logs and temporary files
*.log
tmp/
temp/

# Operating system
.DS_Store
Thumbs.db
