# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.pyd
*.so

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Environment variables
.env

# Raw and processed data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Fitted artifacts and predictions
models/*
!models/.gitkeep
predictions/*
!predictions/.gitkeep
cache/*
!cache/.gitkeep
*.joblib
*.pkl
*.pickle

# Generated figures
figures/*
!figures/.gitkeep

# Superseded artifacts kept outside the tracked tree for traceability.
# results/legacy_cache_manifest.json records what lives here and why.
legacy_cache/

# Logs and temporary files
*.log
tmp/
temp/

# Operating system
.DS_Store
Thumbs.db
