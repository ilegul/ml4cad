# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.pyd
*.so

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Environment variables
.env

# Inputs (data/raw, data/processed) and outputs (results, figures,
# predictions) are tracked, so the analysis can be reproduced and audited
# from the repository alone.

# Fitted estimators are not tracked: 177 MB of binaries that the pipeline
# regenerates from the data and the cached search results.
models/*
!models/.gitkeep
*.joblib
*.pkl
*.pickle

# Resumable intermediates, regenerated on demand.
cache/*
!cache/.gitkeep

# Reduced-size predictive checks, separate from reported sensitivity outputs.
results/predictive_sensitivity_smoke/
predictions/predictive_sensitivity_smoke/
figures/predictive_sensitivity_smoke/

# Logs and temporary files
*.log
tmp/
temp/

# Operating system
.DS_Store
Thumbs.db

# Thesis material is kept outside version control.
Tesi/
